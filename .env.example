# Django
DEBUG=True
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# AI Service URL (for generating full media URLs)
AI_SERVICE_URL=http://localhost:8001

# Database (PostgreSQL) - SHARED DATABASE with BE
# Using same database as BE (video_production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/video_production
# DATABASE_URL=postgresql://user:password@host:port/database  # Production (Cloud SQL)

# RapidAPI — Facebook Scraper (scraper_fanpages + scraper_facebook_reels)
RAPIDAPI_FACEBOOK_KEY=your_rapidapi_key_here

# Apify API (Primary)
# Get your token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Proxy password for Facebook CDN images (lấy từ https://console.apify.com/proxy)
# Khác API token; cần cho Residential Proxy (plan trả phí). Để trống = dùng API token
APIFY_PROXY_PASSWORD=your_apify_proxy_password_here
# Danh sách Country code cho proxy (US, VN, JP, TH, ...). Hệ thống sẽ chọn ngẫu nhiên để linh hoạt lách chặn IP.
APIFY_PROXY_COUNTRIES=VN,US,JP,SG

# Apify Settings
# Global hard cap to avoid wasting credits
APIFY_MAX_RESULTS=500
# Timeout in seconds (20 minutes for large channels)
APIFY_TIMEOUT=1200

# Apify Actor IDs (Optional - override defaults)
# TikTok: clockworks shows accurate stats + avatars; apidojo API often misses them
APIFY_ACTOR_TIKTOK=clockworks/free-tiktok-scraper
APIFY_ACTOR_TIKTOK_PROFILE=apidojo/tiktok-profile-scraper
APIFY_ACTOR_TIKTOK_USER=apidojo/tiktok-user-scraper
# Douyin Scraper (Chinese TikTok)
APIFY_ACTOR_DOUYIN=natanielsantos~douyin-scraper

# Instagram Actors
# Profile info (followers, bio, etc.)
APIFY_ACTOR_INSTAGRAM_PROFILE=apify/instagram-profile-scraper
# Posts & Reels by username (comprehensive scraper)
APIFY_ACTOR_INSTAGRAM_POST=apify/instagram-scraper

# Instagram Cookies (for keyword search - crawlerbros/instagram-keyword-search-scraper)
# JSON array format - regenerate if expired (vào Instagram > Đăng xuất > Đăng nhập lại > copy cookies mới)
INSTAGRAM_COOKIES=your_instagram_cookies_here

# Celery (Redis)
CELERY_BROKER_URL=redis://redis:6379/0