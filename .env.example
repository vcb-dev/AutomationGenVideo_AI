# Django
DEBUG=True
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# AI Service URL (for generating full media URLs)
AI_SERVICE_URL=http://localhost:8001

# Database (PostgreSQL) - SHARED DATABASE with BE
# Using same database as BE (video_production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/video_production
# DATABASE_URL=postgresql://user:password@host:port/database  # Production (Cloud SQL)

# RapidAPI — Facebook Scraper (scraper_fanpages + scraper_facebook_reels)
RAPIDAPI_FACEBOOK_KEY=your_rapidapi_key_here
RAPIDAPI_FACEBOOK_HOST=facebook-scraper-api4.p.rapidapi.com

# TikHub — TikTok/Instagram/Douyin/Xiaohongshu scraper (scraper_tiktok_*, scraper_instagram_*, scraper_douyin_*, scraper_xiaohongshu_*)
TIKHUB_API_KEY=your_tikhub_api_key_here
TIKHUB_API_BASE_URL=https://api.tikhub.io

# Celery (Redis)
CELERY_BROKER_URL=redis://redis:6379/0