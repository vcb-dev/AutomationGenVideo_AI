# Django
DEBUG=True
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# AI Service URL (for generating full media URLs)
AI_SERVICE_URL=http://localhost:8001

# Database (PostgreSQL) - SHARED DATABASE with BE
# Using same database as BE (video_production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/video_production
# DATABASE_URL=postgresql://user:password@host:port/database  # Production (Cloud SQL)

# RapidAPI — Facebook Scraper (scraper_fanpages + scraper_facebook_reels)
RAPIDAPI_FACEBOOK_KEY=your_rapidapi_key_here
RAPIDAPI_FACEBOOK_HOST=facebook-scraper-api4.p.rapidapi.com

# TikHub — TikTok/Instagram/Douyin/Xiaohongshu scraper (scraper_tiktok_*, scraper_instagram_*, scraper_douyin_*, scraper_xiaohongshu_*)
TIKHUB_API_KEY=your_tikhub_api_key_here
TIKHUB_API_BASE_URL=https://api.tikhub.io

# Cobalt — backend dự phòng cho tải video X/Instagram/Facebook (xem cobalt/docker-compose.yml)
COBALT_API_URL=http://localhost:9000

# Celery (Redis)
CELERY_BROKER_URL=redis://redis:6379/0

# MiniMax (TTS + clone giọng). Key thường do BE gửi kèm qua header X-Minimax-Key;
# các biến dưới chỉ là fallback cho management command chạy tay (clone_koc_voice).
MINIMAX_API_KEY=
# Key "sk-api-..." tự gắn group nên để trống; chỉ key JWT cũ (eyJ...) mới cần.
MINIMAX_GROUP_ID=
MINIMAX_API_BASE_URL=https://api.minimax.io/v1
MINIMAX_TTS_MODEL=speech-2.8-hd
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# HeyGen (avatar video). URL đổi được khi cần trỏ proxy/mock — 2 endpoint v1/voice-clone
# dẫn xuất từ URL này (xem heygen_client._api_root), không còn gõ cứng api.heygen.com.
HEYGEN_API_KEY=
HEYGEN_API_URL=https://api.heygen.com/v2

# Model DeepSeek dùng chung (PAAST, sinh script...); BE ghi tên này vào cột model_used.
DEEPSEEK_MODEL=deepseek-v4-flash
