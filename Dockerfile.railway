# Dockerfile dành riêng cho Railway (self-contained, KHÔNG dùng entrypoint
# pip-install lúc chạy như flow NAS/compose). Deps được cài sẵn lúc build,
# gunicorn bind vào $PORT động của Railway.
#
# NAS/compose vẫn dùng ./Dockerfile như cũ — file này chỉ cho Railway
# (railway.toml trỏ dockerfilePath = "Dockerfile.railway").

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8000

WORKDIR /app

# System deps — git cần cho yt-dlp (cài từ git+https trong requirements_cloud.txt)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    ffmpeg \
    git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Cài Python deps (bản cloud nhẹ — không torch)
COPY requirements_cloud.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && rm -rf /root/.cache

# Chromium cho Playwright: Douyin ký mọi request API chi tiết video bằng JS chạy trong trình
# duyệt, nên tải Douyin bắt buộc mở trình duyệt ẩn (video_management/scripts/douyin_extract.py).
# pip chỉ cài THƯ VIỆN playwright, không cài trình duyệt — thiếu bước này thì Douyin luôn hỏng
# ngay (đo trên image Railway: 1.1s, "trình duyệt ẩn gặp sự cố"), cả công cụ Tải video lẫn
# luồng bóc voice sau khi duyệt video vào Bộ Sưu Tập. --with-deps cài kèm thư viện hệ thống.
RUN playwright install --with-deps chromium && rm -rf /var/lib/apt/lists/*

# Copy toàn bộ project
COPY . .

# Gom static cho Django admin (không chặn build nếu lỗi)
RUN python manage.py collectstatic --noinput || true

EXPOSE ${PORT}

# shell form để expand $PORT do Railway cấp; gunicorn phục vụ WSGI.
CMD gunicorn core.wsgi:application \
    --bind 0.0.0.0:${PORT} \
    --workers 2 \
    --threads 4 \
    --timeout 3600 \
    --log-level info
